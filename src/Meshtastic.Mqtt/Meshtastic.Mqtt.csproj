<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meshtastic.Mqtt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Meshtastic" Version="2.0.8" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="MQTTnet.Server" Version="5.2.0.1603" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- Transitive via Meshtastic -> InTheHand.BluetoothLE (never loaded here). Pinned past
         GHSA-xrw6-gwf8-vvr9, which affects Tmds.DBus < 0.92.0. -->
    <PackageReference Include="Tmds.DBus" Version="0.95.1" />
  </ItemGroup>

</Project>
